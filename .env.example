# PostgreSQL Database Connection Configuration
# Used by dbt and Python loader/fetcher
PGHOST=your-db-server.postgres.database.azure.com
PGPORT=5432
PGUSER=your-db-username
PGPASSWORD=your-db-password
PGDATABASE=raw
PGSCHEMA=public
PGSSLMODE=require
PGADMIN_DATABASE=postgres
RAW_DB_NAME=raw
RAW_SCHEMA=public

# Optional device/environment-specific settings:
# Enable experimental adapters in dbt (if required by your dbt setup)
DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true
# Library path for local package managers (e.g. Linuxbrew) if needed
# LD_LIBRARY_PATH=/home/linuxbrew/.linuxbrew/lib
